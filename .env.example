# LM Studio OpenAI-compatible local server
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen3.5-4b

# Optional local server settings
TRAVELMIND_HOST=127.0.0.1
TRAVELMIND_PORT=4173
# TRAVELMIND_WORKSPACE_ROOT=/absolute/path/to/TravelMind

# Mastra local persistence; generated database files are ignored by Git and omitted from the ZIP.
MASTRA_DATABASE_URL=file:./architect.db
MASTRA_TELEMETRY_DISABLED=1
